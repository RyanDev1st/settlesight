# SettleSight Local Environment Configuration
# Copy this file to .env and configure with your credentials

# PayPal Sandbox REST Credentials
# Obtain at: https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# LLM Provider Selection: 'nebius' or 'gemini'
# If omitted, auto-detected from available API keys (defaults to 'gemini')
LLM_PROVIDER=nebius

# Nebius Token Factory / NVIDIA Nemotron Configuration
# Obtain credentials at: https://tokenfactory.nebius.com/
# Recommended models:
# - nvidia/nemotron-3-super-120b-a12b (default, fast tool calling & multi-agent)
# - nvidia/Nemotron-3-Ultra-550b-a55b (deep reasoning exception triage)
# - nvidia/nemotron-3-nano-30b (lightweight)
NEBIUS_API_KEY=
NEBIUS_MODEL=nvidia/nemotron-3-super-120b-a12b

# Google AI Studio Gemini Configuration (Supported Alternative)
# Obtain at: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Local Proxy Server Port (default: 8787)
PORT=8787
