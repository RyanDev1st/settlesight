{
  "name": "settlesight",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "node server/index.mjs",
    "seed": "node scripts/seed-sandbox.mjs",
    "build": "tsc && vite build && vite build --config alexa-sim/vite.config.mjs",
    "vercel-build": "npm run build",
    "mcp": "node --env-file-if-exists=.env mcp/server.mjs",
    "mcp:validate": "node mcp/validate.mjs",
    "alexa-sim": "vite --config alexa-sim/vite.config.mjs",
    "preview": "vite preview",
    "test": "node --test src/match/baseline.test.js src/match/demo.test.js src/match/engine.test.js src/match/normalize.test.js src/match/regression.test.js src/match/rules.test.js src/match/validator.test.js src/agent/agent.test.mjs server/llm.test.mjs server/mode.test.mjs server/paypal.test.mjs server/server.test.mjs mcp/tools.test.mjs mcp/protocol.test.mjs",
    "test:server": "node --test server/*.test.mjs",
    "test:agent": "node --test src/agent/agent.test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "ag-charts-enterprise": "~14.2.0",
    "ag-grid-enterprise": "~36.2.0",
    "ag-stack": "~36.2.0",
    "ag-studio": "3.0.0",
    "ag-studio-react": "3.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.8.2",
    "vite": "^6.0.7"
  }
}
